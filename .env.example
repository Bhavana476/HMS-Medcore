# Copy to .env for Docker Compose. Never commit .env.

# --- Backend ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-at-least-50-random-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=https://localhost
# Comma-separated list of origins allowed to call the API (strict CORS allow-list).
CORS_ALLOWED_ORIGINS=https://localhost

# Encrypts diagnosis/notes at rest. REQUIRED in production. Back it up: losing it makes those fields unreadable.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Optional ClamAV daemon for scanning uploads (uploads are refused if it is set but unreachable)
CLAMAV_HOST=
CLAMAV_PORT=3310

# Database: sqlite (default for local dev), postgres (Docker/production) or mysql
DB_ENGINE=postgres
DB_NAME=medcore_hms
DB_USER=medcore
DB_PASSWORD=change-this-database-password
DB_HOST=postgres
DB_PORT=5432

# Redis is used for throttling counters and caching when set
REDIS_URL=redis://redis:6379/0

# Optional integrations (leave blank to keep them disabled)
PAYMENTS_ENABLED=False
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMS_ENABLED=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENTRY_DSN=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=MedCore <noreply@your-domain>

# Optional MongoDB Atlas export
# MONGODB_URI=
# MONGODB_DB_NAME=medcore_hms

# --- Frontend (build time) ---
VITE_API_URL=/api
